<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
  </PropertyGroup>
  <!-- App identity. $(ApplicationId) is what the Android build stamps as the manifest
       package name (via _GetAndroidPackageName), so it is the id the device installs
       and updates under - changing it later installs a second, separate app. -->
  <PropertyGroup>
    <ApplicationId>com.erwin.swirl2</ApplicationId>
    <ApplicationTitle>Swirl Chart</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
  </PropertyGroup>
  <PropertyGroup>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <!-- The Windows App SDK resolves the AppxPackage MSBuild tasks from
       $(AppxMSBuildToolsPath), which under the .NET SDK points at a folder Microsoft
       does not ship those tasks in - only Visual Studio has them. Without this, plain
       `dotnet build` / `dotnet run` fails with MSB4062 on
       Microsoft.Build.Packaging.Pri.Tasks.ExpandPriContent and only VS MSBuild works.
       Locate the Visual Studio copy and point the SDK at it. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <_AppxPriTaskDll Include="$(ProgramW6432)\Microsoft Visual Studio\*\*\MSBuild\Microsoft\VisualStudio\v*\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll" KeepDuplicates="false" />
  </ItemGroup>
  <PropertyGroup>
    <_AppxPriTaskPath>@(_AppxPriTaskDll->'%(FullPath)')</_AppxPriTaskPath>
    <_AppxPriTaskDir>@(_AppxPriTaskDll->'%(RootDir)%(Directory)')</_AppxPriTaskDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_AppxPriTaskPath)' != ''">
    <PriProjTaskAssembly>$(_AppxPriTaskPath)</PriProjTaskAssembly>
    <AppxMSBuildToolsPath>$(_AppxPriTaskDir)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <!-- Release Android: arm64 only, fully AOT compiled, no debug information, and
       trimmed hard. Verified on device after each of these was turned on. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Real devices are arm64. The default also builds x86_64 for emulators, which
         cost ~14 MB of APK for nothing. Add android-x64 back for an emulator build. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Full AOT of every method, then drop the IL that is no longer needed. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>

    <!-- No debug information of any kind in the package. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>

    <!-- Trim everything the app does not actually call. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!-- Framework features this app never uses. InvariantGlobalization drops the ICU
         data set; every format string here already uses InvariantCulture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>
    </LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <UseMauiEssentials>false</UseMauiEssentials>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- App icon: the original ActSwirl2.exe icon, extracted from its Win32 resources.
       It only ever shipped at 32x32, flat (no alpha channel) on a plain #C0C0C0
       "silver" field - the classic Win16/32 icon background of that era - with real
       art touching several edges of the canvas. Verified with GDI's own ExtractIconEx,
       not just a raw resource dump, so the flat gray is confirmed to be the icon's
       actual appearance, not an extraction artifact. For use as a modern (Android
       adaptive / other) icon: chroma-keyed that exact gray to transparent, cropped to
       content, scaled 4x with nearest-neighbour (keeps the original pixel art crisp
       instead of blurring it), and centred with margin on a 320x320 canvas so nothing
       is clipped by an adaptive-icon mask. Not a redraw - every non-background pixel
       is untouched from the original resource. Color fills that margin and the
       Android adaptive-icon background layer. No MauiIcon item existed before this -
       the app had no custom icon at all. -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0078D4" />
  </ItemGroup>
</Project>